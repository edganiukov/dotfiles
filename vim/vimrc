# fuzzy finder
#
def g:Fzf(choice_cmd: string, vim_cmd: string)
	var output = ''
	try
		output = system(choice_cmd .. ' | fzf --height=40% --bind "ctrl-left:backward-word,ctrl-right:forward-word"')
	catch /Vim:Interrupt/
	# do not fail on errors from ^C, allow redraw! below
	endtry
	redraw!
	var choice = trim(output, "\n")
	if v:shell_error == 0 && !empty(choice)
		exec vim_cmd .. ' ' .. fnameescape(choice)
	endif
enddef

nnoremap <leader>f :call g:Fzf('rg --files', ':e')<CR>

# buffers
#
def g:FzfBuffer()
  var bufnrs: list<number> = filter(range(1, bufnr('$')), 'buflisted(v:val)')
  var buffers = mapnew(bufnrs, 'bufname(v:val)')
  var tmp = tempname()
  writefile(buffers, tmp)
  try
    g:Fzf('cat ' .. shellescape(tmp), ':b')
  finally
    delete(tmp)
  endtry
enddef

nnoremap <leader>e :call g:FzfBuffer()<CR>

# grep
#
def g:Rg()
	var output = ''
	try
		output = system('fzf --height=40% --ansi --disabled --print-query --bind "ctrl-left:backward-word,ctrl-right:forward-word" --bind "change:reload(rg --line-number --column --no-heading --color=always {q} || true)" | tail -1')
	catch /Vim:Interrupt/
	endtry

	redraw!
	output = trim(output, "\n")
	if v:shell_error == 0 && !empty(output)
		var match = matchlist(output, '^\(.\{-}\):\(\d\+\):\(\d\+\):')
		if !empty(match[1])
			exec ':e +' .. match[2] .. ' ' .. fnameescape(match[1])
			cursor(str2nr(match[2]), str2nr(match[3]))
		endif
	endif
enddef

nnoremap <leader>g :call g:Rg()<CR>

