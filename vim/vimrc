def g:Format(formatter: string)
	var view = winsaveview()
	var old = getline(1, '$')
	var input = join(old, "\n")
	if &endofline
		input ..= "\n"
	endif

	var formatted = systemlist(formatter, input)
	if v:shell_error != 0
		echohl ErrorMsg
		echomsg 'Formatting failed: ' .. formatter
		echohl None
		return
	endif

	if empty(formatted)
		formatted = ['']
	endif

	if formatted == old
		return
	endif

	try
		keepjumps lockmarks call setline(1, formatted)
		if line('$') > len(formatted)
			silent! undojoin
			keepjumps lockmarks call deletebufline('%', len(formatted) + 1, '$')
		endif
	finally
		winrestview(view)
	endtry
enddef

