def g:StatusLineMode(): string
	var modes = {
		'n': 'NORMAL',
		'i': 'INSERT',
		'R': 'REPLACE',
		'v': 'VISUAL',
		'V': 'V-LINE',
		"\<C-v>": 'V-BLOCK',
		'c': 'COMMAND',
		's': 'SELECT',
		'S': 'S-LINE',
		"\<C-s>": 'S-BLOCK',
		't': 'TERMINAL'
	}
	return get(modes, mode(), '[NONE]')
enddef

def g:GitStatus(): string
	if !exists('*GitGutterGetHunkSummary')
		return ''
	endif

	var [a,m,r] = g:GitGutterGetHunkSummary()
	return printf('+%d ~%d -%d', a, m, r)
enddef

