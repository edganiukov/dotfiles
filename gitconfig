[core]
	excludesfile = ~/.gitignore

[user]
	name = Ed Ganiukov
	email = ed@gnkv.io
	signingkey = 0x7690B0256F1769BB

[commit]
	gpgsign = true

[gpg]
	program = gpg2

[push]
	default = simple
	autoSetupRemote = true

[pull]
	default = simple
	rebase = true

[color "branch"]
	current = green
	remote = yellow

[diff]
	external = "difft --display=inline"

[alias]
	lg = log --pretty=format:'%Cblue %as %C(auto)%h%d %s %Cgreen[%aN]' --abbrev-commit
	fap = fetch --all --prune
	ps = push
	pl = pull
	co = checkout
	cb = checkout -b
	sw = switch
	cm = commit
	br = branch
	st = status
	dl = log -p --ext-diff
	ds = show --ext-diff
	d = diff
