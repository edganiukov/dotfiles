set $mod Mod4
set $term foot
set $menu wmenu-run-recent -f "monospace 12"
set $lock swaylock -c 181818

# Input
input type:keyboard {
    repeat_delay 256
    repeat_rate 32
    xkb_layout us,ua
    xkb_options grp:caps_toggle
}

input type:touchpad {
    dwt enabled
    click_method clickfinger
}

input type:pointer {
    accel_profile flat
    pointer_accel 0.3
}

# Appearance
font pango:monospace 10
titlebar_border_thickness 1
titlebar_padding 2 2
default_border pixel 1
default_floating_border pixel 1
smart_borders on

# Programs and session
bindsym $mod+q kill
bindsym $mod+Shift+r reload
bindsym $mod+Shift+q exit
bindsym $mod+b bar mode toggle

bindsym $mod+Shift+s exec $lock
bindsym $mod+Return exec $term
bindsym $mod+r exec $menu
bindsym $mod+p exec wmenu-pass -f "monospace 12"

bindsym $mod+Up exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym $mod+Down exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym $mod+0 exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Focus and sizing
bindsym $mod+Shift+h move left
bindsym $mod+Shift+l move right
bindsym $mod+Shift+j resize shrink width 5 ppt
bindsym $mod+Shift+k resize grow width 5 ppt
bindsym $mod+Tab focus next

# Layouts
bindsym $mod+t layout splith
bindsym $mod+f floating toggle
bindsym $mod+m layout toggle split tabbed
bindsym $mod+space layout toggle split

# Outputs
output "HP Inc. HP Z32 CN49390HL7" scale 1.55 scale_filter nearest

bindsym $mod+comma focus output left
bindsym $mod+period focus output right
bindsym $mod+Shift+comma move container to output left
bindsym $mod+Shift+period move container to output right

# Workspaces
bindsym $mod+Left workspace prev_on_output
bindsym $mod+Right workspace next_on_output
bindsym $mod+h workspace prev_on_output
bindsym $mod+l workspace next_on_output
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9


exec swayidle -w \
	timeout 900 '$lock' \
	timeout 1800 'swaymsg "output * power off"' \
	resume 'swaymsg "output * power on"' before-sleep '$lock'

exec wlsunset -l 47.38 -L 8.54 -T 7000 -t 3500 -g 0.9
exec dunst
exec kanshi
exec_always pkill -HUP -x kanshi


# Built-in status bar.
bar {
    position top
    font pango:monospace 12
    workspace_buttons yes
    status_command ~/.config/sway/scripts/status.sh

    colors {
        background #181818
    }
}

