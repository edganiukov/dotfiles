{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "theme": "system",
  "default_agent": "plan",
  "permission": {
    "edit": "ask",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "question": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask",
    "lsp": "allow",
    "skill": "allow",
    "bash": {
      "*": "ask",
      "cat*": "allow",
      "ls*": "allow",
      "grep*": "allow",
      "cd*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "deny",
      "terraform*": "deny",
      "sudo*": "deny",
      "rm*": "deny"
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".direnv/**"]
  }
}
